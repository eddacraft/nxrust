{
  "name": "@eddacraft/nxrust",
  "version": "0.3.0",
  "description": "Nx plugin that wraps Cargo — executors, generators, and project-graph integration for Rust workspaces inside Nx monorepos.",
  "keywords": [
    "cargo",
    "monorepo",
    "nx",
    "nx-plugin",
    "rust",
    "workspace"
  ],
  "homepage": "https://github.com/eddacraft/nxrust",
  "license": "Apache-2.0",
  "author": "eddacraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddacraft/nxrust.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "dist/**/files/**",
    "executors.json",
    "generators.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./tools/copy-assets.mjs",
    "clean": "rm -rf dist",
    "e2e": "node ./tools/e2e-smoke.mjs",
    "cache-matrix": "node ./tools/cache-matrix.mjs",
    "prepublishOnly": "node ./tools/assert-release-branch.mjs && pnpm build && pnpm test && pnpm e2e",
    "release:dry-run": "pnpm build && npm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ltd/j-toml": "^1.38.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@nx/devkit": "^22.7.5",
    "@types/node": "^22.10.0",
    "nx": "^22.7.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "@nx/devkit": "^22.6.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
